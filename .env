# =====================================================================
# FOMS AI Intelligence Layer - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and update variables as needed.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI Gateway Configuration (.NET Integration Gateway)
# ---------------------------------------------------------------------
AI_SERVICE_URL=http://foms-ai-service:8000
AI_SERVICE_API_KEY=change-me

# ---------------------------------------------------------------------
# 2. Database Connections (PostgreSQL & MongoDB)
# ---------------------------------------------------------------------
# POSTGRESQL CONNECTION:
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
POSTGRES_CONNECTION_STRING=postgresql://postgres:hanamarie@localhost:5432/foms_ai_db

# MONGODB CONNECTION:
# Format: mongodb://<host>:<port>/
MONGODB_URI=mongodb://localhost:27017/

# ---------------------------------------------------------------------
# 3. Core FOMS API & AI Service Configuration
# ---------------------------------------------------------------------
FOMS_READ_API_URL=http://localhost:5000
FOMS_AI_SERVICE_API_KEY=<your-foms-api-key>
SYNC_INTERVAL_MINUTES=10
GEMINI_API_KEY=AQ.Ab8RN6I0Qds1JR_1Ptn-JBjPGEvd3DRE_racgvFCWzhdPJqJcw
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------
# 4. JWT Security & Service Authentication
# ---------------------------------------------------------------------
FOMS_JWT_PUBLIC_KEY=<your-rsa-public-key>
FOMS_JWT_ISSUER=https://foms.example.com
FOMS_JWT_AUDIENCE=foms-ai-service
SERVICE_JWT_SECRET=<your-service-jwt-secret>
SERVICE_API_KEY=<your-service-api-key>

# ---------------------------------------------------------------------
# 5. Rate Limiting Settings
# ---------------------------------------------------------------------
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute

# ---------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:80,http://localhost

# ---------------------------------------------------------------------
# 7. Audit Logging & Retention Settings
# ---------------------------------------------------------------------
AUDIT_RETENTION_YEARS=5
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_DAILY=true

# ---------------------------------------------------------------------
# 8. Docker Deployment Settings
# ---------------------------------------------------------------------
POSTGRES_PASSWORD=hanamarie
PORT=80

