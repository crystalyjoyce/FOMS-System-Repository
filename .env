# =====================================================================
# FOMS AI Intelligence Layer - Environment Configuration
# =====================================================================
# This file contains the environment variables required for running the backend services
# (Python AI Service, .NET Integration Gateway, PostgreSQL, and MongoDB).
# =====================================================================

# ---------------------------------------------------------------------
# 1. AI Gateway Configuration (.NET Integration Gateway)
# ---------------------------------------------------------------------
# URL where the .NET Gateway connects to the Python AI service
# Default for Docker container network: http://foms-ai-service:8000
# Default for local running: http://localhost:8000
AI_SERVICE_URL=http://foms-ai-service:8000

# API Key used by Gateway to authenticate requests to AI Service
AI_SERVICE_API_KEY=change-me

# ---------------------------------------------------------------------
# 2. Database Connections (PostgreSQL & MongoDB)
# ---------------------------------------------------------------------
# POSTGRESQL CONNECTION:
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
# Note: Use host.docker.internal if running inside Docker on Windows/Mac, or localhost if running directly.
POSTGRES_CONNECTION_STRING=postgresql://postgres:Postgres2026!@host.docker.internal:5432/foms_ai_db

# MONGODB CONNECTION:
# Format: mongodb://<host>:<port>/
# Used for storing AI logs, vector embeddings, and audit trails.
# Note: Use host.docker.internal:27017 for Docker setup, or mongodb://localhost:27017/ for local setup.
MONGODB_URI=mongodb://host.docker.internal:27017/

# ---------------------------------------------------------------------
# 3. Core FOMS API & AI Service Configuration
# ---------------------------------------------------------------------
# Main FOMS Backend Read API URL (used by AI sync workers to fetch data)
FOMS_READ_API_URL=http://host.docker.internal:5000

# API key for the AI service
FOMS_AI_SERVICE_API_KEY=change-me

# How often (in minutes) the background worker syncs database data for AI analysis
SYNC_INTERVAL_MINUTES=10

# Google Gemini API Key (Insert your Gemini API key from Google AI Studio)
GEMINI_API_KEY=AQ.Ab8RN6LduPGbJtkQjjpMzYCElbIfzyoWcXrGTIrkqKmHx-NUtA

# Model selection for Google Gemini AI features
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------
# 4. JWT Security & Service Authentication
# ---------------------------------------------------------------------
# Public Key / Secret for verifying user authentication tokens
FOMS_JWT_PUBLIC_KEY=change-me-rsa-public-key
FOMS_JWT_ISSUER=https://foms.example.com
FOMS_JWT_AUDIENCE=foms-ai-service

# Secret key for service-to-service communication
SERVICE_JWT_SECRET=change-me-service-secret
SERVICE_API_KEY=change-me-service-api-key

# ---------------------------------------------------------------------
# 5. Rate Limiting Settings
# ---------------------------------------------------------------------
# Limits API requests to prevent server overload
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute

# ---------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ---------------------------------------------------------------------
# Allowed frontend web origins (React app ports, Docker nginx ports)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:80,http://localhost,http://127.0.0.1:5174

# ---------------------------------------------------------------------
# 7. Audit Logging & Retention Settings
# ---------------------------------------------------------------------
# Number of years audit logs are retained
AUDIT_RETENTION_YEARS=5
# Maximum size in MB before log files rotate
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_DAILY=true

# ---------------------------------------------------------------------
# 8. Docker Deployment Settings
# ---------------------------------------------------------------------
# Password for PostgreSQL database initialization in Docker
POSTGRES_PASSWORD=Postgres2026!

# Port for the Gateway/Nginx frontend service
PORT=80

