# FOMS AI Intelligence Layer Configuration Template
# Copy this file to '.env' and update variables as needed.

# 1. AI Gateway Configuration
AI_SERVICE_URL=http://foms-ai-service:8000
AI_SERVICE_API_KEY=<your-gateway-api-key>

# 2. Python AI Service configurations
POSTGRES_CONNECTION_STRING=postgresql://postgres:<password>@host.docker.internal:5432/foms_ai_db
MONGODB_URI=mongodb://host.docker.internal:27017/
FOMS_READ_API_URL=http://host.docker.internal:5000
FOMS_AI_SERVICE_API_KEY=<your-foms-api-key>
SYNC_INTERVAL_MINUTES=10
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# 3. JWT Security (§7)
FOMS_JWT_PUBLIC_KEY=<your-rsa-public-key>
FOMS_JWT_ISSUER=https://foms.example.com
FOMS_JWT_AUDIENCE=foms-ai-service

# 4. Service-to-Service Authentication (§11)
SERVICE_JWT_SECRET=<your-service-jwt-secret>
SERVICE_API_KEY=<your-service-api-key>

# 5. Rate Limiting (§17)
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute

# 6. CORS (§22)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:80,http://localhost

# 7. Audit Logging (§21)
AUDIT_RETENTION_YEARS=5
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_DAILY=true

# 8. Docker deployment settings
POSTGRES_PASSWORD=<your-postgres-password>
PORT=80
