# FOMS AI Intelligence Layer Configuration Template
# Copy this file to '.env' and update variables as needed.

# 1. AI Gateway Configuration
AI_SERVICE_URL=http://foms-ai-service:8000
AI_SERVICE_API_KEY=change-me

# 2. Python AI Service configurations
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@foms-ai-postgres:5432/foms_ai_db
MONGODB_URI=mongodb://foms-ai-mongodb:27017/
FOMS_READ_API_URL=http://foms-legacy-mock:8001
FOMS_AI_SERVICE_API_KEY=change-me
SYNC_INTERVAL_MINUTES=10

# 3. Docker deployment settings
POSTGRES_PASSWORD=postgres
PORT=80
