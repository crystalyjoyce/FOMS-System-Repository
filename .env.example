# =====================================================================
# Finance Operations Management System (FOMS) & AI Intelligence Layer
# Local & Docker Compose Environment Configuration Template (.env.example)
# =====================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Update default passwords and API keys before launching.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Microsoft SQL Server (Official Source of Truth)
# ---------------------------------------------------------------------
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DB=FOMS_DB
MSSQL_PORT=1433

# ---------------------------------------------------------------------
# 2. PostgreSQL & pgAdmin 4 (AI Decision Support & Analytics)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourPostgresPassword
POSTGRES_DB=foms_ai_results
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@foms.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---------------------------------------------------------------------
# 3. MongoDB (Time-Series Finance Trends & Activity Logs)
# ---------------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=YourMongoPassword
MONGO_DB=foms_trends_db
MONGO_PORT=27017

# ---------------------------------------------------------------------
# 4. Connection Strings for Local / Docker Backend Services
# ---------------------------------------------------------------------
# Host-based local connection strings (e.g. running dotnet/python directly on host)
MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=FOMS_DB;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=False;TrustServerCertificate=True;
POSTGRES_CONNECTION_STRING=postgresql://postgres:YourPostgresPassword@localhost:5432/foms_ai_results
MONGODB_URI=mongodb://root:YourMongoPassword@localhost:27017/foms_trends_db?authSource=admin

# ---------------------------------------------------------------------
# 5. Core FOMS API & AI Service Configuration
# ---------------------------------------------------------------------
FOMS_READ_API_URL=http://foms-backend:8080
FOMS_AI_SERVICE_API_KEY=foms-secret-key-2026
AI_SERVICE_URL=http://foms-ai-service:8000
AI_SERVICE_API_KEY=change-me
SYNC_INTERVAL_MINUTES=10

# Google Gemini API (For document OCR classification and anomaly analysis)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------
# 6. Payment Gateway Configuration (PayMongo / SpeedPay)
# ---------------------------------------------------------------------
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here

# ---------------------------------------------------------------------
# 7. JWT Security & Rate Limiting
# ---------------------------------------------------------------------
JWT_SECRET=FOMS_Capstone_JWT_SecureKey_2026!!
JWT_ISSUER=FOMS.Api
JWT_AUDIENCE=FOMS.Api
SERVICE_JWT_SECRET=foms-service-secret-2026
SERVICE_API_KEY=foms-service-api-key-2026

RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute

# ---------------------------------------------------------------------
# 8. CORS & Port Bindings
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://localhost
PORT=80

SPEEDPAY_USERNAME=test-001
SPEEDPAY_PASSWORD=password123
